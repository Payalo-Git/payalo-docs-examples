<% const pageTitle = 'Home'; const currentPath = '/'; %>
<%- include('_layout', { pageTitle, currentPath }) %>

<h1>PayAlo Merchant Gateway v2 — Node sample</h1>
<p class="lead">A walkthrough of the core merchant flows in Node.js + Express + TypeScript.</p>

<h2 class="mt-4">Configuration check</h2>
<table class="table table-bordered w-auto">
  <tbody>
    <tr><th class="bg-light">Base URL</th><td><code><%= config.baseUrl %></code></td></tr>
    <tr>
      <th class="bg-light">API key</th>
      <td>
        <% if (!config.apiKey) { %>
          <span class="text-danger">not set</span>
        <% } else { %>
          <code><%= config.apiKey.slice(0, 3) + '…' + config.apiKey.slice(-3) %></code>
          <small class="text-muted ms-2">(<%= config.apiKey.length %> chars)</small>
        <% } %>
      </td>
    </tr>
    <tr><th class="bg-light">Public base URL</th><td><code><%= config.publicBaseUrl || '(not set — webhooks unreachable)' %></code></td></tr>
    <tr>
      <th class="bg-light">Webhook URL</th>
      <td><code><%= (config.publicBaseUrl ? config.publicBaseUrl.replace(/\/$/, '') : 'https://<your-public-host>') + config.webhookPath %></code></td>
    </tr>
  </tbody>
</table>

<% if (!config.apiKey) { %>
  <div class="alert alert-warning">
    <strong>Set <code>PAYALO_API_KEY</code></strong> before exercising the demos. See the README.
  </div>
<% } %>

<h2 class="mt-4">Live API check</h2>
<p>
  Hits <code>GET /records</code> over the last 5 minutes to confirm your API key is
  accepted. A successful call (even with no records) is enough to validate connectivity.
</p>
<form method="post" action="/connectivity-check">
  <button class="btn btn-primary" type="submit" <% if (!config.apiKey) { %>disabled<% } %>>Run connectivity check</button>
</form>

<%- include('_error', { error }) %>

<% if (connectivity) { %>
  <div class="alert alert-success mt-3">
    Connected. <code>GET /records</code> returned
    <strong><%= connectivity.count %></strong> transaction(s) in the last 5 minutes.
  </div>
<% } %>

<%- include('_footer') %>
