root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,xml,razor,cshtml,html,css,js}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.cs]
# Treat all nullable warnings as errors so a copy-paste mistake is caught at build time.
dotnet_diagnostic.CS8600.severity = warning
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8603.severity = warning
dotnet_diagnostic.CS8604.severity = warning

# var preferences — prefer `var` when the type is obvious from the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:silent

# Prefer expression-bodied members for one-liners.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# File-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:suggestion

# `using` directive ordering: System.* first.
dotnet_sort_system_directives_first = true
