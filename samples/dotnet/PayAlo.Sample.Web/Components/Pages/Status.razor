@page "/status"
@inject PayAloClient Client
@rendermode InteractiveServer

<PageTitle>Status Lookup — PayAlo Samples</PageTitle>

<h1>Status Lookup</h1>
<p>
    Two endpoints; same response shape. Use this to reconcile after a missed callback,
    or as a fallback poll when webhooks aren't reliable in your network.
</p>

<div class="alert alert-info small">
    The recommended-pattern docs say wait at least <strong>2 minutes</strong> between
    polls — the gateway only re-checks the provider that often. The <em>Refresh</em>
    button below re-runs the lookup so you can poll manually.
</div>

<div class="row g-3">
    <div class="col-md-6">
        <h4>By gateway reference</h4>
        <p class="small text-muted mb-2">
            <code>GET /status/{gatewayReference}</code>
        </p>
        <div class="input-group">
            <InputText class="form-control" @bind-Value="_gatewayRef" placeholder="01J1ABCDEF123456" />
            <button class="btn btn-primary" @onclick="LookupByGatewayRef" disabled="@_isLoading">
                Lookup
            </button>
        </div>
    </div>

    <div class="col-md-6">
        <h4>By merchant reference</h4>
        <p class="small text-muted mb-2">
            <code>GET /status/mref/{merchantReference}</code>
        </p>
        <div class="input-group">
            <InputText class="form-control" @bind-Value="_merchantRef" placeholder="dep-…" />
            <button class="btn btn-primary" @onclick="LookupByMerchantRef" disabled="@_isLoading">
                Lookup
            </button>
        </div>
    </div>
</div>

<hr class="my-4" />

@if (_apiException is not null)
{
    <ProblemDetailsAlert Exception="_apiException" />
}
else if (_transaction is not null)
{
    <h3 class="d-flex justify-content-between align-items-center">
        <span>
            @_transaction.Type — @_transaction.Flow
            <StatusBadge Status="_transaction.Status" />
        </span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@_isLoading">
            @(_isLoading ? "Refreshing…" : "Refresh")
        </button>
    </h3>

    <div class="row">
        <div class="col-lg-6">
            <table class="table table-sm">
                <tbody>
                    <tr><th>gatewayReference</th><td><code>@_transaction.GatewayReference</code></td></tr>
                    <tr><th>merchantReference</th><td><code>@(_transaction.MerchantReference ?? "—")</code></td></tr>
                    <tr><th>providerReference</th><td><code>@(_transaction.ProviderReference ?? "—")</code></td></tr>
                    <tr><th>method / country</th><td><code>@_transaction.Method</code> / @_transaction.Country</td></tr>
                    <tr>
                        <th>requested</th>
                        <td>@_transaction.RequestedAmount.Value.ToString("0.00") @_transaction.RequestedAmount.Currency</td>
                    </tr>
                    <tr>
                        <th>final</th>
                        <td>
                            @if (_transaction.FinalAmount is { } final)
                            {
                                @($"{final.Value:0.00} {final.Currency}")
                            }
                            else
                            {
                                <em class="text-muted">not settled</em>
                            }
                        </td>
                    </tr>
                    <tr><th>createdAt</th><td>@_transaction.CreatedAt.ToLocalTime():g</td></tr>
                    <tr>
                        <th>completedAt</th>
                        <td>@(_transaction.CompletedAt is { } c ? c.ToLocalTime().ToString("g") : "—")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="col-lg-6">
            @if (_transaction.Status == "failed" && _transaction.ErrorCode is { Length: > 0 })
            {
                <div class="alert alert-danger">
                    <h5 class="mb-1">
                        Failed
                        <span class="badge bg-danger ms-2">@_transaction.ErrorCode</span>
                    </h5>
                    <strong>@(_transaction.ErrorMessage ?? "")</strong>
                    <hr />
                    <small>@PayAloErrorMessages.Describe(_transaction.ErrorCode, _transaction.ErrorMessage)</small>
                </div>
            }
            else if (_transaction.Status == "pending")
            {
                <div class="alert alert-warning">
                    Still processing — wait a couple of minutes and click <em>Refresh</em>.
                </div>
            }
            else if (_transaction.Status == "success")
            {
                <div class="alert alert-success">Transaction settled successfully.</div>
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "gw")] public string? GwQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mref")] public string? MrefQuery { get; set; }

    private string _gatewayRef = "";
    private string _merchantRef = "";
    private MmoTransactionDto? _transaction;
    private PayAloApiException? _apiException;
    private bool _isLoading;
    // Tracks which lookup powered the current result so the Refresh button can re-run it.
    private Func<Task<MmoTransactionDto>>? _lastLookup;

    protected override async Task OnInitializedAsync()
    {
        // Other pages link here with ?gw=… so deep-linking from "you just initiated" → status works.
        if (!string.IsNullOrWhiteSpace(GwQuery))
        {
            _gatewayRef = GwQuery;
            await LookupByGatewayRef();
        }
        else if (!string.IsNullOrWhiteSpace(MrefQuery))
        {
            _merchantRef = MrefQuery;
            await LookupByMerchantRef();
        }
    }

    private Task LookupByGatewayRef() => string.IsNullOrWhiteSpace(_gatewayRef)
        ? Task.CompletedTask
        : Lookup(() => Client.GetByGatewayReferenceAsync(_gatewayRef.Trim()));

    private Task LookupByMerchantRef() => string.IsNullOrWhiteSpace(_merchantRef)
        ? Task.CompletedTask
        : Lookup(() => Client.GetByMerchantReferenceAsync(_merchantRef.Trim()));

    private Task RefreshAsync() => _lastLookup is null ? Task.CompletedTask : Lookup(_lastLookup);

    private async Task Lookup(Func<Task<MmoTransactionDto>> call)
    {
        _isLoading = true;
        _apiException = null;

        try
        {
            _transaction = await call();
            _lastLookup = call;
        }
        catch (PayAloApiException ex)
        {
            _apiException = ex;
            _transaction = null;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
