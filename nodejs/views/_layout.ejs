<%# Reusable header. Each page sets `pageTitle` and `currentPath` then renders this. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> — Payalo Node Sample</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body { display: flex; min-height: 100vh; margin: 0; }
    aside { width: 240px; min-height: 100vh; background: linear-gradient(180deg, #052767 0%, #3a0647 70%); color: #fff; padding: 1rem; }
    aside h1 { font-size: 1rem; line-height: 1.25; margin: 0 0 1rem 0; }
    aside a { color: #d7d7d7; display: block; padding: 0.45rem 0.6rem; border-radius: 4px; text-decoration: none; font-size: 0.95rem; }
    aside a:hover { background: rgba(255,255,255,0.1); color: #fff; }
    aside a.active { background: rgba(255,255,255,0.37); color: #fff; }
    main { flex: 1; padding: 1.5rem 2rem; }
    code, pre { font-size: 0.85rem; }
  </style>
</head>
<body>
  <aside>
    <h1>Payalo Gateway v2 — Node sample</h1>
    <% [
      ['/', 'Home'],
      ['/direct-payin', 'Direct Pay-In'],
      ['/web-payin', 'Web Pay-In (HPP)'],
      ['/qr-payin', 'QR Pay-In'],
      ['/direct-payout', 'Direct Pay-Out'],
      ['/direct-tax-payout', 'Tax Payout'],
      ['/status', 'Status Lookup'],
      ['/records', 'Records'],
      ['/webhooks', 'Webhooks']
    ].forEach(([href, label]) => { %>
      <a href="<%= href %>" class="<%= currentPath === href ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </aside>
  <main>
