<%# Renders a Payalo gateway error in a Bootstrap alert. %>
<% if (error) { %>
  <div class="alert alert-danger" role="alert">
    <h5 class="alert-heading mb-1">
      <%= error.status %>
      <% if (error.errorCode) { %><span class="badge bg-danger ms-2"><%= error.errorCode %></span><% } %>
    </h5>
    <% if (error.title) { %><strong><%= error.title %>.</strong> <% } %>
    <span><%= error.detail %></span>
    <hr />
    <small class="text-muted"><%= error.friendly %></small>
    <% if (!error.isRetryable) { %>
      <div class="mt-2 small"><em>Not retryable — use a fresh <code>merchantReference</code> before resubmitting.</em></div>
    <% } %>
    <% if (error.traceId) { %>
      <div class="mt-2 small text-muted">Trace: <code><%= error.traceId %></code></div>
    <% } %>
  </div>
<% } %>
