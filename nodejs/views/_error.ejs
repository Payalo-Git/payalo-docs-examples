<%# Renders a Payalo gateway error in a Bootstrap alert. %>
<% if (error) { %>
  <div class="alert alert-danger" role="alert">
    <h5 class="alert-heading mb-1">
      <%= error.status %>
      <% if (error.errorCode) { %><span class="badge bg-danger ms-2"><%= error.errorCode %></span><% } %>
    </h5>
    <% if (error.title) { %><strong><%= error.title %>.</strong> <% } %>
    <span><%= error.detail %></span>
    <hr />
    <small class="text-muted"><%= error.friendly %></small>
    <% if (typeof isCreate !== 'undefined' && isCreate) { %>
      <% if (error.status >= 500 || error.status === 0 || error.status === 408 || error.status === 429) { %>
        <div class="mt-2 small"><em>Payalo may have registered this payment. Read Payment Status by <code>merchantReference</code> before you send again.</em></div>
      <% } else if ([400, 401, 422].includes(error.status) && error.errorCode !== 'merchant_reference_duplicate') { %>
        <div class="mt-2 small"><em>Nothing was created. Fix the request and send it again. The same <code>merchantReference</code> can be used.</em></div>
      <% } %>
    <% } %>
    <% if (error.traceId) { %>
      <div class="mt-2 small text-muted">Trace: <code><%= error.traceId %></code></div>
    <% } %>
  </div>
<% } %>
