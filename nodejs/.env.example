# Copy to `.env` and fill in real values. `.env` is gitignored.

# Required: your Payalo brand API key.
PAYALO_API_KEY=pk_live_replace_me

# Recommended: public origin where this app is reachable so the gateway can call our
# webhook endpoint. Use your ngrok / Cloudflare tunnel URL in development.
PAYALO_PUBLIC_BASE_URL=https://your-ngrok-host.ngrok-free.app

# Optional overrides.
# PAYALO_BASE_URL=https://dev-api-internal.payalo.com/gateway/mmo/v2/
# PAYALO_WEBHOOK_PATH=/webhooks/payalo
# PORT=3000
