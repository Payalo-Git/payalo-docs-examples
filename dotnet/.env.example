# Copy to `.env` and fill in your real values. `.env` is git-ignored.
#
# Note the double-underscore: in .NET configuration, `__` maps to a nested key,
# so `Payalo__ApiKey` binds to PayaloOptions.ApiKey.

# Required: your Payalo brand API key.
Payalo__ApiKey=pk_live_replace_me

# Required: where this app is reachable from the public internet so the gateway can
# call our webhook endpoint. Use your ngrok / Cloudflare tunnel URL in development.
Payalo__PublicBaseUrl=https://your-ngrok-host.ngrok-free.app

# Optional overrides. Defaults point at the production API.
# Payalo__BaseUrl=https://api.payalo.com/gateway/mmo/v2/
# Payalo__WebhookPath=/webhooks/payalo

# Container listens on this port — docker-compose maps host 8080 → container 8080.
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Production
