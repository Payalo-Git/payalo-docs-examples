@page "/direct-tax-payout"
@using Microsoft.Extensions.Options
@inject PayaloClient Client
@inject IOptionsMonitor<PayaloOptions> OptionsMonitor
@rendermode InteractiveServer

<PageTitle>Direct Tax Payout — Payalo Samples</PageTitle>

<h1>Direct Tax Payout</h1>
<p>
    <code>POST /direct/taxpayout/{method}</code> — disburse to a tax authority. The payee
    is implicit (the tax authority configured for this method); you only send the amount,
    country, and references.
</p>

<div class="alert alert-info small">
    Two differences from a regular pay-out: no <code>payer</code>/<code>payee</code> object
    on the request, and <code>reconciliationReference</code> is <strong>required</strong>
    (optional everywhere else). The recipient is implicitly the tax authority configured
    for the payment method.
</div>

<div class="row">
    <div class="col-lg-7">
        <EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="direct-tax-payout">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Method key</label>
                <InputText class="form-control" @bind-Value="_method" placeholder="e.g. tax-ke" />
            </div>

            <h4>Amount</h4>
            <div class="row g-2">
                <div class="col">
                    <label class="form-label">Value</label>
                    <InputNumber class="form-control" @bind-Value="_request.Amount.Value" step="0.01" />
                </div>
                <div class="col">
                    <label class="form-label">Currency</label>
                    <InputText class="form-control" @bind-Value="_request.Amount.Currency" />
                </div>
            </div>

            <h4 class="mt-4">Routing</h4>
            <div class="mb-2">
                <label class="form-label">Country</label>
                <InputText class="form-control" @bind-Value="_request.Country" />
            </div>
            <div class="mb-2">
                <label class="form-label">Result URL</label>
                <InputText class="form-control" @bind-Value="_request.ResultUrl" />
            </div>
            <div class="mb-2">
                <label class="form-label">Merchant reference</label>
                <InputText class="form-control" @bind-Value="_request.MerchantReference" />
            </div>
            <div class="mb-2">
                <label class="form-label">Reconciliation reference (required)</label>
                <InputText class="form-control" @bind-Value="_request.ReconciliationReference" />
                <ValidationMessage For="() => _request.ReconciliationReference" />
            </div>

            <button type="submit" class="btn btn-primary mt-3" disabled="@_isSubmitting">
                @(_isSubmitting ? "Submitting…" : "Initiate tax payout")
            </button>
        </EditForm>
    </div>

    <div class="col-lg-5">
        @if (_apiException is not null)
        {
            <ProblemDetailsAlert Exception="_apiException" IsCreate="true" />
        }
        else if (_response is not null)
        {
            <div class="alert alert-success">
                <h5>Accepted — pending</h5>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><th>gatewayReference</th><td><code>@_response.GatewayReference</code></td></tr>
                        <tr><th>merchantReference</th><td><code>@_response.MerchantReference</code></td></tr>
                        <tr><th>reconciliationReference</th><td><code>@_response.ReconciliationReference</code></td></tr>
                        <tr><th>createdAt</th><td>@_response.CreatedAt.ToLocalTime():g</td></tr>
                    </tbody>
                </table>
                <p class="small mt-2 mb-0">
                    📡 Watch <a href="webhooks">/webhooks</a> for the terminal callback.
                </p>
            </div>
        }
    </div>
</div>

@code {
    private readonly DirectTaxPayoutRequest _request = new();
    private string _method = "tax-ke";
    private InitiatePaymentResponseDto? _response;
    private PayaloApiException? _apiException;
    private bool _isSubmitting;

    protected override void OnInitialized() => SeedRequest();

    private void SeedRequest()
    {
        var options = OptionsMonitor.CurrentValue;
        var publicBase = string.IsNullOrWhiteSpace(options.PublicBaseUrl)
            ? "https://example.com"
            : options.PublicBaseUrl.TrimEnd('/');

        _request.Amount.Value = 15000.00m;
        _request.Amount.Currency = "KES";
        _request.Country = "KE";
        _request.MerchantReference = $"tax-{Guid.NewGuid():N}";
        _request.ReconciliationReference = $"TAX-{DateTime.UtcNow:yyyyMM}-{Guid.NewGuid():N}";
        _request.ResultUrl = $"{publicBase}{options.WebhookPath}";
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _response = null;
        _apiException = null;

        try
        {
            _response = await Client.CreateDirectTaxPayoutAsync(_method.Trim(), _request);
        }
        catch (PayaloApiException ex)
        {
            _apiException = ex;
        }
        finally
        {
            _isSubmitting = false;
            _request.MerchantReference = $"tax-{Guid.NewGuid():N}";
            _request.ReconciliationReference = $"TAX-{DateTime.UtcNow:yyyyMM}-{Guid.NewGuid():N}";
        }
    }
}
