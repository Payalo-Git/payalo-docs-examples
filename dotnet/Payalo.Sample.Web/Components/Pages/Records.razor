@page "/records"
@inject PayaloClient Client
@rendermode InteractiveServer

<PageTitle>Records — Payalo Samples</PageTitle>

<h1>Records (bulk reconciliation)</h1>
<p>
    <code>GET /records</code> — paged window of transactions, useful for catching up after
    a callback outage or running a daily reconciliation against your ledger.
</p>

<div class="alert alert-info small">
    Every call repeats the From, To and filter values. A page cursor is only valid for the
    query that produced it, so editing the filter form and moving to the next page returns 400.
    Search again to start from page 1 with the new filters.
</div>

<EditForm Model="this" OnValidSubmit="LoadFirstPageAsync" FormName="records-filter">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From (UTC)</label>
            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_from" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To (UTC)</label>
            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_to" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Type</label>
            <InputSelect class="form-select" @bind-Value="_type">
                <option value="">(any)</option>
                <option value="payin">payin</option>
                <option value="payout">payout</option>
                <option value="tax">tax</option>
            </InputSelect>
        </div>
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <InputSelect class="form-select" @bind-Value="_status">
                <option value="">(any)</option>
                <option value="pending">pending</option>
                <option value="success">success</option>
                <option value="failed">failed</option>
            </InputSelect>
        </div>
        <div class="col-md-2">
            <label class="form-label">Page size</label>
            <InputNumber class="form-control" @bind-Value="_pageSize" />
        </div>
    </div>
    <div class="row g-2 mt-2">
        <div class="col-md-4">
            <label class="form-label">Method (optional)</label>
            <InputText class="form-control" @bind-Value="_method" placeholder="mpesa-ke" />
        </div>
        <div class="col-md-8 align-self-end text-end">
            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                @(_isLoading ? "Loading…" : "Search")
            </button>
        </div>
    </div>
</EditForm>

<hr class="my-4" />

@if (_apiException is not null)
{
    <ProblemDetailsAlert Exception="_apiException" />
}
else if (_page is not null)
{
    @if (_page.Data.Count == 0)
    {
        <p class="text-muted"><em>No transactions matched the filters.</em></p>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Created</th>
                    <th>Type</th>
                    <th>Method</th>
                    <th>Amount</th>
                    <th>Gateway ref</th>
                    <th>Merchant ref</th>
                    <th>Status</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in _page.Data)
                {
                    <tr>
                        <td>@tx.CreatedAt.ToLocalTime():g</td>
                        <td><small>@tx.Type / @tx.Flow</small></td>
                        <td><code>@tx.Method</code></td>
                        <td>@(tx.RequestedAmount is { } r ? $"{r.Value:0.00} {r.Currency}" : "—")</td>
                        <td>
                            <a href="@($"status?gw={tx.GatewayReference}")">
                                <code>@tx.GatewayReference</code>
                            </a>
                        </td>
                        <td><code>@(tx.MerchantReference ?? "—")</code></td>
                        <td><StatusBadge Status="tx.Status" /></td>
                        <td>
                            @if (!string.IsNullOrEmpty(tx.ErrorCode))
                            {
                                <span class="badge bg-danger" title="@tx.ErrorMessage">@tx.ErrorCode</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mt-3">
            <button class="btn btn-outline-secondary"
                    @onclick="LoadPreviousAsync"
                    disabled="@(_page.Pages.Previous is null || _isLoading)">
                ← Previous
            </button>
            <small class="text-muted align-self-center">@_page.Data.Count records on this page.</small>
            <button class="btn btn-outline-secondary"
                    @onclick="LoadNextAsync"
                    disabled="@(_page.Pages.Next is null || _isLoading)">
                Next →
            </button>
        </div>
    }
}

@code {
    private DateTime _from = DateTime.UtcNow.AddDays(-1);
    private DateTime _to = DateTime.UtcNow;
    private string _type = "";
    private string _method = "";
    private string _status = "";
    private int _pageSize = 50;

    private RecordsResponseDto? _page;
    private PayaloApiException? _apiException;
    private bool _isLoading;

    private Task LoadFirstPageAsync() => LoadAsync(pageCursor: null);
    private Task LoadNextAsync() => LoadAsync(_page?.Pages.Next);
    private Task LoadPreviousAsync() => LoadAsync(_page?.Pages.Previous);

    private async Task LoadAsync(string? pageCursor)
    {
        _isLoading = true;
        _apiException = null;

        try
        {
            // Every call repeats the filters; the cursor is only valid for the same query.
            _page = await Client.GetRecordsAsync(
                from: new DateTimeOffset(DateTime.SpecifyKind(_from, DateTimeKind.Utc)),
                to: new DateTimeOffset(DateTime.SpecifyKind(_to, DateTimeKind.Utc)),
                type: NullIfEmpty(_type),
                method: NullIfEmpty(_method),
                status: NullIfEmpty(_status),
                pageSize: _pageSize,
                pageCursor: pageCursor);
        }
        catch (PayaloApiException ex)
        {
            _apiException = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
