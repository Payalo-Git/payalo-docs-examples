@page "/qr-payin"
@using Microsoft.Extensions.Options
@inject PayaloClient Client
@inject IOptionsMonitor<PayaloOptions> OptionsMonitor
@rendermode InteractiveServer

<PageTitle>QR Pay-In — Payalo Samples</PageTitle>

<h1>QR Pay-In</h1>
<p>
    <code>POST /qr/payin/{method}</code> — QR-code deposit. The gateway POSTs the QR
    payload to your <code>displayQrUrl</code> after initiation; your application is then
    responsible for rendering the QR for the end user to scan.
</p>

<div class="alert alert-info small">
    The required <code>displayQrUrl</code> is the only structural difference from Direct
    Pay-In. The default points at this sample's own receiver (<code>/webhooks/payalo/qr</code>),
    which logs the QR data and answers 200. In a real integration it points at your checkout,
    which answers with a 2xx status first and then shows the QR code.
</div>

<div class="row">
    <div class="col-lg-7">
        <EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="qr-payin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Method key</label>
                <InputText class="form-control" @bind-Value="_method" placeholder="e.g. mpesa-ke" />
            </div>

            <h4>Amount</h4>
            <div class="row g-2">
                <div class="col">
                    <label class="form-label">Value</label>
                    <InputNumber class="form-control" @bind-Value="_request.Amount.Value" step="0.01" />
                </div>
                <div class="col">
                    <label class="form-label">Currency</label>
                    <InputText class="form-control" @bind-Value="_request.Amount.Currency" />
                </div>
            </div>

            <h4 class="mt-4">Payer</h4>
            <div class="mb-2">
                <label class="form-label">User ID</label>
                <InputText class="form-control" @bind-Value="_request.Payer.Id" />
            </div>
            <div class="mb-2">
                <label class="form-label">MSISDN</label>
                <InputText class="form-control" @bind-Value="_request.Payer.Msisdn" />
                <ValidationMessage For="() => _request.Payer.Msisdn" />
            </div>

            <h4 class="mt-4">Routing</h4>
            <div class="mb-2">
                <label class="form-label">Country</label>
                <InputText class="form-control" @bind-Value="_request.Country" />
            </div>
            <div class="mb-2">
                <label class="form-label">Result URL</label>
                <InputText class="form-control" @bind-Value="_request.ResultUrl" />
            </div>
            <div class="mb-2">
                <label class="form-label">Display QR URL</label>
                <InputText class="form-control" @bind-Value="_request.DisplayQrUrl" />
                <ValidationMessage For="() => _request.DisplayQrUrl" />
            </div>
            <div class="mb-2">
                <label class="form-label">Merchant reference</label>
                <InputText class="form-control" @bind-Value="_request.MerchantReference" />
            </div>

            <button type="submit" class="btn btn-primary mt-3" disabled="@_isSubmitting">
                @(_isSubmitting ? "Submitting…" : "Initiate QR pay-in")
            </button>
        </EditForm>
    </div>

    <div class="col-lg-5">
        @if (_apiException is not null)
        {
            <ProblemDetailsAlert Exception="_apiException" IsCreate="true" SubmittedReference="_submittedReference" />
        }
        else if (_response is not null)
        {
            <div class="alert alert-success">
                <h5>Accepted — pending</h5>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><th>gatewayReference</th><td><code>@_response.GatewayReference</code></td></tr>
                        <tr><th>merchantReference</th><td><code>@_response.MerchantReference</code></td></tr>
                        <tr><th>createdAt</th><td>@_response.CreatedAt.ToLocalTime():g</td></tr>
                    </tbody>
                </table>
                <p class="small mt-2 mb-0">
                    📡 Watch <a href="webhooks">/webhooks</a> for the terminal callback.
                </p>
            </div>
        }
    </div>
</div>

@code {
    private readonly QrPayInRequest _request = new();
    private string? _submittedReference;
    private string _method = "mpesa-ke";
    private InitiatePaymentResponseDto? _response;
    private PayaloApiException? _apiException;
    private bool _isSubmitting;

    protected override void OnInitialized() => SeedRequest();

    private void SeedRequest()
    {
        var options = OptionsMonitor.CurrentValue;
        var publicBase = string.IsNullOrWhiteSpace(options.PublicBaseUrl)
            ? "https://example.com"
            : options.PublicBaseUrl.TrimEnd('/');

        _request.Amount.Value = 500.00m;
        _request.Amount.Currency = "KES";
        _request.Payer.Id = "user-42";
        _request.Payer.Msisdn = "+254712345678";
        _request.Country = "KE";
        _request.MerchantReference = $"qr-{Guid.NewGuid():N}";
        _request.ResultUrl = $"{publicBase}{options.WebhookPath}";
        _request.DisplayQrUrl = $"{publicBase}{options.WebhookPath.TrimEnd('/')}/qr";
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _response = null;
        _apiException = null;
        _submittedReference = _request.MerchantReference;

        try
        {
            _response = await Client.CreateQrPayInAsync(_method.Trim(), _request);
        }
        catch (PayaloApiException ex)
        {
            _apiException = ex;
        }
        finally
        {
            _isSubmitting = false;
            _request.MerchantReference = $"qr-{Guid.NewGuid():N}";
        }
    }
}
