@page "/web-payin"
@using Microsoft.Extensions.Options
@inject PayaloClient Client
@inject IOptionsMonitor<PayaloOptions> OptionsMonitor
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Web Pay-In (HPP) — Payalo Samples</PageTitle>

<h1>Web Pay-In (Hosted Payment Page)</h1>
<p>
    <code>POST /web/payin/{method}</code> — gateway returns a hosted payment page URL.
    Redirect the end user to <code>pageUrl</code>; the gateway redirects them back to your
    success or error URL when done.
</p>

<div class="alert alert-warning small">
    <strong>Source of truth.</strong> The post-payment redirect is for UX only. Always rely
    on the webhook callback to <code>resultUrl</code> for the authoritative status — a
    redirect can be tampered with or never reached.
</div>

<div class="row">
    <div class="col-lg-7">
        <EditForm Model="_request" OnValidSubmit="SubmitAsync" FormName="web-payin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Method key</label>
                <InputText class="form-control" @bind-Value="_method" placeholder="e.g. card-eu" />
            </div>

            <h4>Amount</h4>
            <div class="row g-2">
                <div class="col">
                    <label class="form-label">Value</label>
                    <InputNumber class="form-control" @bind-Value="_request.Amount.Value" step="0.01" />
                </div>
                <div class="col">
                    <label class="form-label">Currency</label>
                    <InputText class="form-control" @bind-Value="_request.Amount.Currency" />
                </div>
            </div>

            <h4 class="mt-4">Payer</h4>
            <div class="mb-2">
                <label class="form-label">User ID</label>
                <InputText class="form-control" @bind-Value="_request.Payer.Id" />
            </div>
            <div class="mb-2">
                <label class="form-label">MSISDN</label>
                <InputText class="form-control" @bind-Value="_request.Payer.Msisdn" />
                <ValidationMessage For="() => _request.Payer.Msisdn" />
            </div>

            <h4 class="mt-4">Routing</h4>
            <div class="mb-2">
                <label class="form-label">Country</label>
                <InputText class="form-control" @bind-Value="_request.Country" />
            </div>
            <div class="mb-2">
                <label class="form-label">Result URL (webhook)</label>
                <InputText class="form-control" @bind-Value="_request.ResultUrl" />
            </div>
            <div class="row g-2">
                <div class="col">
                    <label class="form-label">Success redirect URL</label>
                    <InputText class="form-control" @bind-Value="_request.SuccessRedirectUrl" />
                </div>
                <div class="col">
                    <label class="form-label">Error redirect URL</label>
                    <InputText class="form-control" @bind-Value="_request.ErrorRedirectUrl" />
                </div>
            </div>
            <div class="mt-2">
                <label class="form-label">Preferred language</label>
                <InputText class="form-control" @bind-Value="_request.PreferredLanguage" placeholder="e.g. fr-FR" />
                <div class="form-text">Optional BCP-47 language-REGION tag; unknown values fall back to English.</div>
            </div>

            <div class="mt-2">
                <label class="form-label">Merchant reference</label>
                <InputText class="form-control" @bind-Value="_request.MerchantReference" />
            </div>

            <button type="submit" class="btn btn-primary mt-3" disabled="@_isSubmitting">
                @(_isSubmitting ? "Submitting…" : "Get payment page")
            </button>
        </EditForm>
    </div>

    <div class="col-lg-5">
        @if (_apiException is not null)
        {
            <ProblemDetailsAlert Exception="_apiException" IsCreate="true" SubmittedReference="_submittedReference" />
        }
        else if (_response is not null)
        {
            <div class="alert alert-success">
                <h5>Accepted — redirect to the hosted page</h5>
                <p class="mb-2">
                    <strong>pageUrl:</strong>
                    <a href="@_response.PageUrl" target="_blank" rel="noopener">@_response.PageUrl</a>
                </p>
                <button class="btn btn-primary btn-sm" @onclick="RedirectToPaymentPage">
                    Open payment page →
                </button>
                <p class="small mt-2 mb-0 text-muted">
                    📡 Watch <a href="webhooks">/webhooks</a> for the terminal callback —
                    that's the authoritative status.
                </p>
            </div>
        }
    </div>
</div>

@code {
    private readonly WebPayInRequest _request = new();
    private string? _submittedReference;
    private string _method = "card-eu";
    private WebPayInResponseDto? _response;
    private PayaloApiException? _apiException;
    private bool _isSubmitting;

    protected override void OnInitialized() => SeedRequest();

    private void SeedRequest()
    {
        var options = OptionsMonitor.CurrentValue;
        var publicBase = string.IsNullOrWhiteSpace(options.PublicBaseUrl)
            ? "https://example.com"
            : options.PublicBaseUrl.TrimEnd('/');

        _request.Amount.Value = 25.00m;
        _request.Amount.Currency = "EUR";
        _request.Payer.Id = "user-42";
        _request.Payer.Msisdn = "+491234567890";
        _request.Country = "DE";
        _request.MerchantReference = $"web-{Guid.NewGuid():N}";
        _request.ResultUrl = $"{publicBase}{options.WebhookPath}";
        _request.SuccessRedirectUrl = $"{publicBase}/status";
        _request.ErrorRedirectUrl = $"{publicBase}/status";
        _request.PreferredLanguage = "fr-FR";
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _response = null;
        _apiException = null;
        _submittedReference = _request.MerchantReference;

        try
        {
            _response = await Client.CreateWebPayInAsync(_method.Trim(), _request);
        }
        catch (PayaloApiException ex)
        {
            _apiException = ex;
        }
        finally
        {
            _isSubmitting = false;
            _request.MerchantReference = $"web-{Guid.NewGuid():N}";
        }
    }

    private void RedirectToPaymentPage()
    {
        if (_response is null) return;
        // forceLoad: true bypasses Blazor's enhanced navigation so the browser fully
        // navigates to the cross-origin HPP URL.
        Nav.NavigateTo(_response.PageUrl, forceLoad: true);
    }
}
