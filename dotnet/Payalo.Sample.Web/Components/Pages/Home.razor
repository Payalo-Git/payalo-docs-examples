@page "/"
@using Microsoft.Extensions.Options
@inject IOptionsMonitor<PayaloOptions> OptionsMonitor
@inject PayaloClient Client
@rendermode InteractiveServer

<PageTitle>Payalo Gateway v2 — Samples</PageTitle>

<h1>Payalo Merchant Gateway v2 — Sample Integration</h1>
<p class="lead">
    A walkthrough of the core merchant flows: payment initiation, hosted payment pages,
    disbursements, status lookups, reconciliation, and webhook callbacks.
</p>

<h2 class="mt-4">Configuration check</h2>
<table class="table table-bordered w-auto">
    <tbody>
        <tr>
            <th class="bg-light">Base URL</th>
            <td><code>@(string.IsNullOrWhiteSpace(_options.BaseUrl) ? "(not set)" : _options.BaseUrl)</code></td>
        </tr>
        <tr>
            <th class="bg-light">API key</th>
            <td>
                @if (string.IsNullOrWhiteSpace(_options.ApiKey))
                {
                    <span class="text-danger">not set</span>
                }
                else
                {
                    <code>@MaskKey(_options.ApiKey)</code>
                    <small class="text-muted ms-2">(@_options.ApiKey.Length chars)</small>
                }
            </td>
        </tr>
        <tr>
            <th class="bg-light">Public base URL</th>
            <td>
                <code>@(string.IsNullOrWhiteSpace(_options.PublicBaseUrl) ? "(not set — webhooks unreachable)" : _options.PublicBaseUrl)</code>
            </td>
        </tr>
        <tr>
            <th class="bg-light">Webhook URL</th>
            <td>
                <code>@WebhookUrl()</code>
            </td>
        </tr>
    </tbody>
</table>

@if (!_options.IsConfigured)
{
    <div class="alert alert-warning">
        <strong>Set <code>Payalo:BaseUrl</code> and <code>Payalo:ApiKey</code></strong> before exercising the demos.
        See the README for instructions (user-secrets in dev, environment variables in Docker).
    </div>
}

<h2 class="mt-4">Live API check</h2>
<p>
    Hits <code>GET /records</code> over the last 5 minutes to confirm your API key is
    accepted. A successful call (even with no records) is enough to validate connectivity.
</p>

<button class="btn btn-primary" @onclick="CheckConnectivityAsync" disabled="@(!_options.IsConfigured || _isChecking)">
    @(_isChecking ? "Checking…" : "Run connectivity check")
</button>

@if (_apiException is not null)
{
    <div class="mt-3">
        <ProblemDetailsAlert Exception="_apiException" />
    </div>
}
else if (_lastCheck is not null)
{
    <div class="alert alert-success mt-3">
        Connected. <code>GET /records</code> returned
        <strong>@_lastCheck.Data.Count</strong> transaction(s) in the last 5 minutes.
    </div>
}

<h2 class="mt-5">Reading order</h2>
<ol>
    <li><strong>Direct Pay-In</strong> — server-to-server STK push deposit.</li>
    <li><strong>Web Pay-In</strong> — Hosted Payment Page redirect flow.</li>
    <li><strong>Direct Pay-Out</strong> — disbursement to an end user.</li>
    <li><strong>Status Lookup</strong> — fetch a transaction by gateway or merchant reference.</li>
    <li><strong>Records</strong> — paginated list for bulk reconciliation.</li>
    <li><strong>Webhooks</strong> — live feed of inbound callbacks the gateway delivers to this app.</li>
</ol>

@code {
    private PayaloOptions _options = new();
    private RecordsResponseDto? _lastCheck;
    private PayaloApiException? _apiException;
    private bool _isChecking;

    protected override void OnInitialized()
    {
        _options = OptionsMonitor.CurrentValue;
    }

    private async Task CheckConnectivityAsync()
    {
        _isChecking = true;
        _apiException = null;
        _lastCheck = null;

        try
        {
            var now = DateTimeOffset.UtcNow;
            _lastCheck = await Client.GetRecordsAsync(
                from: now.AddMinutes(-5),
                to: now,
                pageSize: 1);
        }
        catch (PayaloApiException ex)
        {
            _apiException = ex;
        }
        finally
        {
            _isChecking = false;
        }
    }

    private static string MaskKey(string key) =>
        key.Length <= 6 ? "******" : $"{key[..3]}…{key[^3..]}";

    private string WebhookUrl()
    {
        var baseUrl = string.IsNullOrWhiteSpace(_options.PublicBaseUrl)
            ? "https://<your-public-host>"
            : _options.PublicBaseUrl.TrimEnd('/');
        return $"{baseUrl}{_options.WebhookPath}";
    }
}
