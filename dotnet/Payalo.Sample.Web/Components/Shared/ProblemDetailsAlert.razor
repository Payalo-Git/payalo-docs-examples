@* Renders a PayaloApiException as a Bootstrap alert with the parsed Problem Details and
   a friendly explanation pulled from PayaloErrorMessages. Use this in every page that
   calls the PayaloClient so error UX stays consistent. *@

@if (Exception is not null)
{
    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading mb-1">
            @((int)Exception.StatusCode) @Exception.StatusCode
            @if (!string.IsNullOrWhiteSpace(Exception.ErrorCode))
            {
                <span class="badge bg-danger ms-2">@Exception.ErrorCode</span>
            }
        </h5>

        @if (!string.IsNullOrWhiteSpace(Exception.Title))
        {
            <strong>@Exception.Title.</strong>
        }

        <span>@(Exception.Detail ?? Exception.Message)</span>

        <hr />
        <small class="text-muted">
            @PayaloErrorMessages.Describe(Exception.SpecificCode,
                fallback: PayaloErrorMessages.Describe(Exception.ErrorCode, fallback: "Check the request body and try again."))
        </small>

        @if (IsCreate && Exception.IsRetryable)
        {
            <div class="mt-2 small">
                <em>Payalo may have registered this payment. Read Payment Status for <code>merchantReference</code> @if (!string.IsNullOrWhiteSpace(SubmittedReference)) {<a href="@($"/status?mref={Uri.EscapeDataString(SubmittedReference)}")"><code>@SubmittedReference</code></a>} before you send again.</em>
            </div>
        }
        else if (IsCreate && (int)Exception.StatusCode is 400 or 401 or 422 && Exception.ErrorCode != "merchant_reference_duplicate")
        {
            <div class="mt-2 small">
                <em>Nothing was created. Fix the request and send it again. The same <code>merchantReference</code> can be used.</em>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Exception.TraceId))
        {
            <div class="mt-2 small text-muted">
                Trace: <code>@Exception.TraceId</code>
            </div>
        }
    </div>
}

@code {
    [Parameter] public PayaloApiException? Exception { get; set; }

    // Set on the pages that create a payment. Only then does the alert say whether the payment may exist.
    [Parameter] public bool IsCreate { get; set; }

    // The merchantReference that the user just submitted. The form already shows the next one.
    [Parameter] public string? SubmittedReference { get; set; }
}
